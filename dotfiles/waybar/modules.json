{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": [
    "mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "mpris": {
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{player_icon}  {dynamic}",
    "format-stopped": "",
    "dynamic-len": 40,
    "dynamic-order": ["title", "artist"],
    "player-icons": {
      "default": "🎵",
      "spotify": "",
      "firefox": "󰈹"
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "ignored-players": [],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-"
  },
  "river/window": {
    "format": "{}",
    "max-length": 50
  },
  "clock": {
    "interval": 60,
    "format": "󰥔  {:%a %b %d  %I:%M %p}",
    "format-alt": "󰥔  {:%a %b %d  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#a6da95'><b>{}</b></span>",
        "days": "<span color='#cad3f5'><b>{}</b></span>",
        "weeks": "<span color='#8aadf4'><b>W{}</b></span>",
        "weekdays": "<span color='#ed8796'><b>{}</b></span>",
        "today": "<span color='#f5a97f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "timeout 2 wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 150
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -d intel_backlight set 5%+",
    "on-scroll-down": "brightnessctl -d intel_backlight set 5%-",
    "tooltip-format": "Brightness: {percent}%",
    "smooth-scrolling-threshold": 1
  },
  "custom/microphone": {
    "format": "{}",
    "exec": "bash -c 'out=$(timeout 2 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null); if [ -z \"$out\" ]; then echo \"{\\\"text\\\":\\\"󰍭  --\\\",\\\"class\\\":\\\"error\\\"}\"; elif echo \"$out\" | grep -q MUTED; then echo \"{\\\"text\\\":\\\"󰍭  Muted\\\",\\\"class\\\":\\\"muted\\\"}\"; else vol=$(echo \"$out\" | awk \"{print int(\\$2 * 100)}\"); echo \"{\\\"text\\\":\\\"󰍬  $vol%\\\",\\\"class\\\":\\\"\\\"}\"; fi'",
    "on-click": "timeout 2 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "timeout 2 wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "timeout 2 wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "interval": 30,
    "return-type": "json",
    "tooltip": false
  },
  "custom/bluetooth": {
    "format": "{}",
    "exec": "bash -c 'out=$(bluetoothctl show 2>/dev/null); if ! echo \"$out\" | grep -q \"Powered: yes\"; then echo \"{\\\"text\\\":\\\"󰂲\\\",\\\"class\\\":\\\"off\\\",\\\"tooltip\\\":\\\"Bluetooth Off\\\"}\"; exit 0; fi; connected=$(bluetoothctl devices Connected 2>/dev/null); if [ -n \"$connected\" ]; then device=$(echo \"$connected\" | head -1 | cut -d\" \" -f3- | cut -c1-15); echo \"{\\\"text\\\":\\\"󰂱\\\",\\\"class\\\":\\\"connected\\\",\\\"tooltip\\\":\\\"$device\\\"}\"; else echo \"{\\\"text\\\":\\\"󰂯\\\",\\\"class\\\":\\\"on\\\",\\\"tooltip\\\":\\\"Bluetooth On\\\"}\"; fi'",
    "interval": 30,
    "return-type": "json",
    "on-click": "blueman-manager",
    "tooltip": true
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "󰖪  Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "on-click": "kitty -e nmtui",
    "interval": 30
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power}W",
    "on-click": "kitty -e btop"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive-items": true
  },
  "custom/separator": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#mic": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#2": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#3": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#4": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#bluetooth": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator#5": {
    "format": "│",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/powermenu/powermenu.sh"
  }
}
